{
  "name": "artifacty",
  "version": "0.16.1",
  "description": "Local artifact exchange for heterogeneous LLM agents via HTTP and MCP.",
  "type": "module",
  "keywords": [
    "llm",
    "agent",
    "artifacts",
    "mcp",
    "claude",
    "codex",
    "gemini"
  ],
  "homepage": "https://github.com/raeseoklee/artifacty#readme",
  "bugs": {
    "url": "https://github.com/raeseoklee/artifacty/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/raeseoklee/artifacty.git"
  },
  "bin": {
    "artifacty": "src/cli.js",
    "artifacty-mcp": "src/mcp-server.js"
  },
  "scripts": {
    "start": "node src/server.js",
    "mcp": "node src/mcp-server.js",
    "test": "node --test",
    "lint": "node scripts/lint.mjs",
    "docs:check": "node scripts/check-docs.mjs",
    "build:ui": "node scripts/build-ui.mjs",
    "smoke": "bash scripts/smoke.sh",
    "release:check": "npm run lint && npm test && npm run smoke"
  },
  "files": [
    "src",
    "docs/artifact-schema-v1.md",
    "docs/assets/artifacty.png",
    "docs/assets/screenshots",
    "docs/user-guide.md",
    "docs/central-team-deployment-design.md",
    "docs/integrations.md",
    "docs/language-packs.md",
    "docs/mcp-public-api.md",
    "docs/network-sharing.md",
    "docs/release-checklist.md",
    "docs/roadmap-design.md",
    "docs/sarif-csv-artifact-plan.md",
    "docs/smtp.md",
    "docs/threat-model.md",
    "docs/upgrade-backups.md",
    "docs/writing-style.md",
    "scripts/lint.mjs",
    "scripts/build-ui.mjs",
    "scripts/smoke.sh",
    "README.md",
    "LICENSE",
    "SECURITY.md",
    "THIRD_PARTY_NOTICES.md",
    "AGENTS.md",
    "CLAUDE.md",
    "README.ko.md",
    "SECURITY.ko.md",
    "docs/README.md",
    "docs/ko",
    "docs/claude-artifact-formats.md"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "license": "MIT",
  "dependencies": {
    "@codemirror/lang-html": "^6.4.11",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.0",
    "codemirror": "^6.0.2",
    "mermaid": "^12.1.0"
  },
  "optionalDependencies": {
    "@babel/standalone": "^8.0.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@tabler/icons": "^3.49.0",
    "bootstrap": "^5.3.8",
    "sass": "^1.105.1"
  }
}
